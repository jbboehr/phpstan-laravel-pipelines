
rules:
  - jbboehr\PHPStan\Laravel\Pipeline\PipelineThenRule

services:
  - class: jbboehr\PHPStan\Laravel\Pipeline\StubFilesExtension
    tags: ["phpstan.stubFilesExtension"]
  - class: jbboehr\PHPStan\Laravel\Pipeline\PipelineTypeSpecifyingExtension
    tags: ["phpstan.typeSpecifier.methodTypeSpecifyingExtension"]
