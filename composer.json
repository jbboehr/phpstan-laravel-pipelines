{
    "name": "jbboehr/phpstan-laravel-pipelines",
    "type": "phpstan-extension",
    "description": "",
    "license": "AGPL-3.0+",
    "homepage": "https://github.com/jbboehr/phpstan-laravel-pipelines",
    "authors": [
        {
            "name": "John Boehr",
            "email": "jbboehr@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "phpstan/phpstan": "^1.12 || ^2.0",
        "symfony/http-foundation": "^6 || ^7"
    },
    "autoload": {
        "psr-4": {
            "jbboehr\\PHPStan\\Laravel\\Pipeline\\": "src/"
        }
    },
    "require-dev": {
        "composer-runtime-api": "*",
        "brick/varexporter": "*",
        "larastan/larastan": "^2.11 || ^3.4",
        "laravel/framework": "^9 || ^10 || ^11 || ^12",
        "orchestra/testbench": "^7.55 || ^8.36 || ^9.14 || ^10.3",
        "phpstan/phpstan-phpunit": "^1.4.2 || ^2.0.6",
        "phpstan/phpstan-strict-rules": "^1.6.2 || ^2.0.4",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5",
        "slevomat/coding-standard": "^8.18",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload-dev": {
        "psr-4": {
            "jbboehr\\PHPStan\\Laravel\\Pipeline\\\\Tests\\": "tests",
            "jbboehr\\PHPStan\\Laravel\\Pipeline\\\\Tests\\Fixture\\": "tests/fixtures",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false
        }
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "scripts": {
        "phpcs": "./vendor/bin/phpcs",
        "phpstan": "./vendor/bin/phpstan",
        "phpunit": "./vendor/bin/phpunit",
        "switch-to-laravel": [
            "composer require --no-update --dev laravel/framework:^@additional_args && composer upgrade -W"
        ],
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "@php vendor/bin/phpstan analyse --verbose --ansi"
        ],
        "test": [
            "@clear",
            "@php vendor/bin/phpunit"
        ]
    },
    "_comment": [
        "Think not that I am come to send peace on earth: I came not to send peace, but a sword. Matthew 10:34"
    ]
}
